{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@main/*": [
        "./src/main/*"
      ],
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "src/preload/index.d.ts",
    "src/shared/**/*.ts",
    "src/main/**/*.ts",
    "src/renderer/src/lib/**/*.ts",
    "scripts/lib/**/*.mjs"
  ]
}