# ─────────────────────────────────────────────────────────────────────────────
# JARVIS — environment configuration
# Copy this file to `.env` and fill in your own keys. `.env` is git-ignored.
# Keys are read by the MAIN process only; they are never sent to the renderer.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Claude — used for reasoning, planning and multi-step automation.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq — used for low-latency replies, intent classification and speech-to-text.
# https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default models.
# JARVIS_CLAUDE_MODEL=claude-sonnet-5
# JARVIS_GROQ_MODEL=llama-3.3-70b-versatile
# JARVIS_GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional: override where JARVIS stores settings, memory, routines and logs.
# Defaults to the OS application-data directory.
# JARVIS_DATA_DIR=

# Optional: start in demo mode (simulated activity, no API calls, clearly labelled).
# JARVIS_DEMO=1
